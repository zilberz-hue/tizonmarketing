PORT=3000
# חשבון מנהל ראשוני (נוצר בהפעלה הראשונה אם אין משתמשים)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# כתיבת תוכן אוטומטית (אופציונלי)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# פרסום אוטומטי (כל חיבור אופציונלי; בלי חיבור – הפוסט מסומן "ידני")
FB_PAGE_ID=
FB_PAGE_TOKEN=
TG_BOT_TOKEN=
TG_CHAT_ID=
# Webhook כללי (Make / Zapier / n8n) לאינסטגרם, לינקדאין, טיקטוק, אימייל, וואטסאפ וכו'
PUBLISH_WEBHOOK_URL=
# true = פוסטים שה-AI מייצר מתפרסמים בלי אישור ידני
AUTO_APPROVE=false
# אם האתר מתארח בדומיין אחר מהשרת
ALLOWED_ORIGIN=
